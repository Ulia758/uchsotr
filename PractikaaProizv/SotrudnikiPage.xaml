<Page x:Class="PractikaaProizv.SotrudnikiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PractikaaProizv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SotrudnikiPage">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="#FFBCC9FC"/>
            <Setter Property="Foreground" Value="#DD000000"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="150"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FFE4E2FF" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Сотрудники" FontSize="24" FontWeight="Bold" Foreground="Black" Margin="0,0,10,0" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="10,5,0,5">
            <Label Content="Отдел:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Name="DepartmentFilter" SelectedIndex="0" SelectionChanged="DepartmentFilter_SelectionChanged">
                <ComboBoxItem Content="Все" Tag=""/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 28 0 0">
            <Button x:Name="Add" Content="Добавить" Click="Add_Click"/>
            <Button x:Name="ReportBtn" Content="Отчет по отделам" Click="ReportBtn_Click"/>
            <Button x:Name="Nazad" Content="Назад" Click="Nazad_Click"/>
        </StackPanel>
        <DataGrid x:Name="SotrDG" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False" BorderThickness="1" BorderBrush="Gray" CanUserSortColumns="True" SelectionMode="Single" SelectedItem="{Binding Path=SelectedAttendance, Mode=TwoWay}"
              AlternatingRowBackground="SeaShell" RowBackground="WhiteSmoke" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код сотрудника" Binding="{Binding IdSotr}" Width="Auto"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Familia}" Width="120"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Imya}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding Otchestvo}" Width="120"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Adress}" Width="120"/>
                <DataGridTextColumn Header="Паспорт" Binding="{Binding Passport}" Width="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="120"/>
                <DataGridTextColumn Header="Инвалидность" Binding="{Binding Invalidnost}" Width="120"/>
                <DataGridTextColumn Header="Образование" Binding="{Binding Education}" Width="120"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Dolgnosti.Nazvanie}" Width="120"/>
                <DataGridTemplateColumn Header="Действия" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="EditBtn" Content="Изменить" CommandParameter="{Binding}" Click="EditBtn_Click" Background="#FFBCC9FC" Foreground="#DD000000" Margin="5"/>
                                <Button x:Name="FireBtn" Content="Уволить" CommandParameter="{Binding}" Click="Fire_Click" Background="#FFAAABBA" Foreground="#DD000000" Margin="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
