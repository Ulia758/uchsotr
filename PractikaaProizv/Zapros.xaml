<Page x:Class="PractikaaProizv.Zapros"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PractikaaProizv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Zapros" Loaded="Page_Loaded">
    <Grid Background="#FFE4E2FF" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
            <TextBlock Text="Выберите нужного сотрудника" FontSize="24" FontWeight="Bold" Foreground="Black" Margin="0,0,10,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,10,0">
            <ComboBox x:Name="ZaprBox" Height="30" Width="217" Margin="10" />
            <Button x:Name="ZaprosBtn" Content="Вывести" Margin="5" Height="30" Width="150" Background="#FFBCC9FC" Foreground="#DD000000" Click="Zapr_Click"/>
            <Button x:Name="Nazad" Content="Назад" Margin="5" Height="30" Width="150" Background="#FFBCC9FC" Foreground="#DD000000" Click="Nazad_Click"/>
        </StackPanel>
        <DataGrid x:Name="ZaprosDG" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" SelectedItem="{Binding Path=SelectedEmployee, Mode=TwoWay}"
              AlternatingRowBackground="SeaShell" RowBackground="WhiteSmoke" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Sotrudniki.Familia}" Width="200"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding RavocheeVremya.Data, StringFormat=\{0:dd.MM.yyyy\}}" Width="150"/>
                <DataGridTextColumn Header="Время начала работы" Binding="{Binding RavocheeVremya.VremyaHachalaRab}" Width="150"/>
                <DataGridTextColumn Header="Время окончания работы" Binding="{Binding RavocheeVremya.VremyaOkonchaniyaRab}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
