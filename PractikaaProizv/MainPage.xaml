<Page x:Class="PractikaaProizv.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PractikaaProizv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">
    <Grid Background= "#FFF9F7FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Учёт сотрудников" Grid.Row="0" FontSize="30" FontWeight="Bold" Margin="0 8 0 10" HorizontalAlignment="Center" Foreground="Black"/>
        <Button Name="SotrudnikiBtn" Grid.Row="1" Width="400" Height="44" Content="Сотрудники"  Foreground="#DD000000" Cursor="Hand"  FontSize="22" Click="SotrudnikiBtn_Click" Background="#FFCEA9F1"/>
        <Button Name="DolgnostiBtn" Grid.Row="2" Width="400" Height="44" Content="Должности"  Background="#FFCEA9F1" Foreground="#DD000000" FontSize="22" Click="DolgnostiBtn_Click" />
        <Button Name="PosechaemostBtn" Grid.Row="3" Width="400" Height="44" Content="Посещаемость"  Background="#FFCEA9F1" Foreground="#DD000000" FontSize="22" Click="PosechaemostBtn_Click" />
        <Button Name="OtdeliBtn" Grid.Row="4" Width="400" Height="44" Content="Отделы" Background="#FFCEA9F1" Foreground="#DD000000" Cursor="Hand" FontSize="22" Click="OtdeliBtn_Click" />
        <Button Name="OtpuskaBtn" Grid.Row="5" Width="400" Height="44" Content="Отпуска"  Background="#FFCEA9F1" Foreground="#DD000000" FontSize="22" Click="OtpuskaBtn_Click" />
        <Button Name="OtchetiBtn" Grid.Row="6" Width="400" Height="44" Content="Отчёты"  Background="#FFCEA9F1" Foreground="#DD000000" FontSize="22" Click="OtchetiBtn_Click"  />
        <Button Name="Exit" Content="Выход" Grid.Row="7" Width="400" Height="44" Background="#FFCEA9F1" Foreground="#DD000000" FontSize="22" Click="Exit_Click"/>
        <Image  Grid.Row="0" Source="/45721f645eae1eb788fb070e9c9ef619.png" Margin="0 0 10 22" HorizontalAlignment="Right" Width="130" Height="34" Stretch="Uniform" />
    </Grid>
</Page>
